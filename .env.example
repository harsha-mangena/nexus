# ===== Nexus Environment Variables =====

# --- LLM Providers ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- WhatsApp (WAHA) ---
WAHA_URL=http://localhost:3001

# --- Voice ---
WHISPER_URL=http://localhost:3002
PIPER_URL=http://localhost:3003

# --- Memory ---
MEMORY_DB_PATH=./data/nexus.db
MEMORY_MAX_CONTEXT_TURNS=20

# --- Security ---
RATE_LIMIT_PER_MINUTE=30

# --- GitHub ---
GITHUB_TOKEN=

# --- General ---
NODE_ENV=production
LOG_LEVEL=info
CONFIG_PATH=./config/nexus.yaml
